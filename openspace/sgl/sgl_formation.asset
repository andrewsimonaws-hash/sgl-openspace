  BoundingSphere = 10,
  GUI = { Name = "Spacecraft 12", Path = "/SGL/Formation" }
}

local Trail11 = {
  Identifier = "SGL_SC11_Trail",
  Parent = sgl.SGL_ImagePlane.Identifier,
  Renderable = {
    Type = "RenderableTrailTrajectory",
    Translation = Path11,
    Color = { 0.95, 0.5, 0.8 },
    StartTime = "2075-01-01T00:00:00",
    EndTime = "2075-01-14T10:16:23",
    SampleInterval = 600,
    EnableFade = false,
    LineWidth = 1.5,
    Opacity = 0.8
  },
  GUI = { Name = "Spacecraft 12 trail", Path = "/SGL/Formation" }
}

local nodes = { SC00, Trail00, SC01, Trail01, SC02, Trail02, SC03, Trail03, SC04, Trail04, SC05, Trail05, SC06, Trail06, SC07, Trail07, SC08, Trail08, SC09, Trail09, SC10, Trail10, SC11, Trail11 }

asset.onInitialize(function()
  for _, n in ipairs(nodes) do openspace.addSceneGraphNode(n) end
end)

asset.onDeinitialize(function()
  for i = #nodes, 1, -1 do openspace.removeSceneGraphNode(nodes[i]) end
end)
